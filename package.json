{
  "name": "reversely-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n BACKEND,FRONTEND -c cyan,magenta \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "npm --prefix backend start",
    "server:dev": "npm --prefix backend run dev",
    "server:seed": "npm --prefix backend run seed",
    "db:users": "node backend/src/scripts/showData.js users",
    "db:reqs": "node backend/src/scripts/showData.js requirements",
    "db:offers": "node backend/src/scripts/showData.js offers",
    "db:orders": "node backend/src/scripts/showData.js orders",
    "db:all": "node backend/src/scripts/showData.js all",
    "db:stats": "node backend/src/scripts/queryDb.js stats",
    "db:today": "node backend/src/scripts/queryDb.js today",
    "db:date": "node backend/src/scripts/queryDb.js date",
    "db:role": "node backend/src/scripts/queryDb.js role",
    "db:status": "node backend/src/scripts/queryDb.js status",
    "test:backend": "npm --prefix backend test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.5",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.0.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
