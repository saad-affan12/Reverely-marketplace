# ============================================================
# REVERSELY Backend Environment Configuration
# ============================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local instance)
# For local MongoDB: mongodb://127.0.0.1:27017/reversely
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/reversely?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/reversely

# JWT Signing Secret (replace with a cryptographically secure random string in production)
JWT_SECRET=super_secret_reversely_jwt_key_2026_production

# Frontend Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173
